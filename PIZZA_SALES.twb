                <zone forceUpdate='true' h='28333' id='35' type-v2='text' w='17625' x='2125' y='31889'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#8cd17d' fontname='Segoe UI Semibold' fontsize='11' underline='true'>HOURS</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='10'>Peak orders are </run>
                    <run fontalignment='1' fontcolor='#e15759' fontname='Segoe UI Semibold' fontsize='10'>between</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#e15759' fontname='Segoe UI Semibold' fontsize='10'>12:00 PM and 1:00 PM, </run>
                    <run fontalignment='1' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='10'>and in</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='10'>evening.</run>
                    <run fontalignment='1' fontcolor='#f717f7' fontname='Segoe UI Semibold' fontsize='10'>Æ </run>
                    <run fontalignment='1' fontcolor='#e15759' fontname='Segoe UI Semibold' fontsize='10'>from 4:00 Pm to</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#e15759' fontname='Segoe UI Semibold' fontsize='10'>7:00 PM</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#a0cbe8' fontname='Segoe UI Semibold' fontsize='11' underline='true'>WEEKS</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#f17b79' fontname='Segoe UI Semibold' fontsize='10'>Significant variations in</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#f17b79' fontname='Segoe UI Semibold' fontsize='10'>weekly orders, </run>
                    <run fontalignment='1' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='10'>with highest</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='10'>peak during the </run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontname='Segoe UI Semibold' fontsize='10'>48th week</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontname='Segoe UI Semibold' fontsize='10'>from the </run>
                    <run fontalignment='1' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='10'>month of Dec.</run>
                  </formatted-text>
